# Committed template — no real secrets in this file.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Do NOT add VITE_SUPABASE_SERVICE_ROLE_KEY here or anywhere VITE_-prefixed.
# Any VITE_-prefixed env var gets inlined into the client-side JS bundle at
# build time, so the service role key would ship to every visitor's browser.
# The service role key is only ever used inside supabase/functions/* (Edge
# Functions), where Supabase injects it automatically as SUPABASE_SERVICE_ROLE_KEY.
# See supabase/functions/README.md.

VITE_READ_ONLY_MODE=false
VITE_APP_URL=
